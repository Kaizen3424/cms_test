---
/**
 * Footer — the always-dark band (DESIGN.md role token --solid stays dark in
 * both themes). Links mirror the nav; Studio link included.
 */
import { Compass, ExternalLink } from "lucide-react"

interface Props {
  readonly siteTitle: string
  readonly footerText: string | undefined
}

const { siteTitle, footerText } = Astro.props
---

<footer class="border-t border-hairline bg-solid text-on-solid">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-6 py-12 text-sm md:flex-row">
    <div class="flex items-center gap-3">
      <span class="grid h-9 w-9 place-items-center rounded-xl bg-primary/90 text-[#0e0f0c]" aria-hidden>
        <Compass className="h-5 w-5" strokeWidth={2.2} />
      </span>
      <span>
        <span class="font-semibold text-on-solid">{siteTitle}</span>
        <p class="text-xs text-on-solid/70">{footerText}</p>
      </span>
    </div>

    <div class="flex items-center gap-6 text-xs text-on-solid/80">
      <a href="#stories" class="transition-colors hover:text-primary">Dispatches</a>
      <a href="#destinations" class="transition-colors hover:text-primary">Destinations</a>
      <a href="/journal/" class="transition-colors hover:text-primary">Journal</a>
      <a href="/admin/" class="flex items-center gap-1 text-primary transition-colors hover:text-primary-active">
        CMS Studio <ExternalLink className="h-3 w-3" aria-hidden />
      </a>
      <a href="/rss.xml" class="transition-colors hover:text-primary">RSS</a>
    </div>
  </div>
</footer>
