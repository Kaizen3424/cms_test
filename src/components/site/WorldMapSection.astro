---
import WorldMap from '../islands/WorldMap';
import type { CollectionEntry } from 'astro:content';
import type { WorldMapPlace } from '../islands/WorldMap';

interface Props {
  places: CollectionEntry<'places'>[];
}

const { places } = Astro.props;

const mapPlaces: WorldMapPlace[] = places.map((p) => ({
  id: p.id,
  name: p.data.name,
  country: p.data.country,
  category: p.data.category,
  lat: p.data.lat,
  lng: p.data.lng,
  dispatchNumber: p.data.dispatchNumber,
  oneLineFragment: p.data.oneLineFragment,
  coordinatesText: p.data.coordinatesText,
  heroImage: p.data.heroImage,
}));
---

<section
  id="hero-map"
  class="relative w-full h-[92vh] min-h-[640px] pt-16 sm:pt-24 map-canvas overflow-hidden flex items-center justify-center border-b border-[#e2dfd7]"
>
  <WorldMap client:load places={mapPlaces} />
</section>
