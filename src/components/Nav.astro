---
/**
 * Nav — translucent material bar (DESIGN.md → Materials: content scrolls
 * under it); the lime CTA is the one primary button. `siteTitle` comes from
 * the CMS-managed settings.
 */
import { Compass, Sliders } from "lucide-react"
import ThemeToggle from "./ThemeToggle.astro"

interface Props {
  readonly siteTitle: string
}

const { siteTitle } = Astro.props

const links = [
  { href: "#stories", label: "Dispatches" },
  { href: "#destinations", label: "Destinations" },
  { href: "#about", label: "The Explorer" },
  { href: "#tips", label: "Travel Philosophy" },
  { href: "#newsletter", label: "Dispatch Club" },
]
---

<header data-nav class="site-nav material-thick">
  <div class="site-nav-inner">
    <div class="flex items-center gap-3">
      <span class="grid h-10 w-10 place-items-center rounded-full bg-solid text-primary shadow-e1" aria-hidden>
        <Compass className="h-6 w-6" strokeWidth={2.2} />
      </span>
      <span class="flex flex-col leading-tight">
        <a href="/" class="text-lg font-bold tracking-tight text-ink transition-colors">{siteTitle}</a>
        <span class="text-[11px] font-medium uppercase tracking-wider text-mute">Field Notes &amp; Dispatches</span>
      </span>
    </div>

    <nav class="hidden items-center gap-8 text-sm font-medium md:flex" aria-label="Primary">
      {links.map((link) => <a href={link.href} class="nav-link">{link.label}</a>)}
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a
        href="/admin/"
        data-reveal-delay="0"
        class="pressable hidden items-center gap-2 rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-on-primary shadow-e1 transition-colors hover:bg-primary-active sm:inline-flex"
      >
        <Sliders className="h-3.5 w-3.5" aria-hidden />
        <span>Studio / CMS Admin</span>
      </a>
    </div>
  </div>
</header>
