---
/**
 * Destinations — sage band with white/sage split cards (DESIGN.md
 * card-feature-sage on card-canvas). Real pages exist at /destinations/<slug>/.
 */
import { CheckCircle2 } from "lucide-react"
import type { CollectionEntry } from "astro:content"

interface Props {
  readonly destinations: CollectionEntry<"destinations">[]
  readonly heroFallback: string
}

const { destinations, heroFallback } = Astro.props
---

<section id="destinations" class="border-y border-hairline bg-canvas-soft-warm">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="mx-auto mb-16 max-w-2xl text-center" data-reveal>
      <div class="t-eyebrow mb-3 text-positive-strong">Field guides</div>
      <h2 class="t-display-md mb-4 text-ink">Curated mountain &amp; cultural havens</h2>
      <p class="text-sm leading-relaxed text-body">
        Every location has been scouted on foot. Detailed field reports with optimum seasons, packing
        requirements, and secret sanctuaries.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        destinations.map((dest, index) => (
          <a
            href={`/destinations/${dest.id}/`}
            data-reveal
            data-reveal-delay={String(0.06 * index)}
            class="pressable group flex flex-col overflow-hidden rounded-xl bg-canvas shadow-e1 transition-shadow hover:shadow-e2 lg:flex-row"
          >
            <div class="relative min-h-[200px] overflow-hidden bg-canvas-soft lg:w-2/5">
              <img
                src={dest.data.heroImage ?? heroFallback}
                alt={dest.data.name}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
              />
              <span class="absolute top-3 left-3 rounded-md bg-primary px-2 py-0.5 text-[10px] font-bold tracking-wider text-on-primary uppercase">
                {dest.data.country}
              </span>
            </div>

            <div class="flex grow flex-col justify-between p-6 lg:w-3/5">
              <div>
                <h3 class="mb-2 text-xl font-bold text-ink transition-colors group-hover:text-positive-strong">
                  {dest.data.name}
                </h3>
                <p class="mb-4 line-clamp-3 text-xs leading-relaxed text-body">{dest.data.description}</p>

                <div class="mb-4 space-y-1.5">
                  {dest.data.highlights?.slice(0, 3).map((hl) => (
                    <div class="flex items-start gap-2 text-xs text-body">
                      <CheckCircle2 className="mt-0.5 h-3.5 w-3.5 shrink-0 text-positive-strong" aria-hidden />
                      <span>{hl}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="flex items-center justify-between border-t border-hairline pt-4 text-[11px]">
                <span class="text-mute">
                  Best season: <strong class="font-medium text-positive-strong">{dest.data.bestTimeToVisit?.split(" ")[0]}</strong>
                </span>
                <span class="text-mute">
                  Climate: <strong class="font-medium text-body">{dest.data.climate?.split(" ")[0]}</strong>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
