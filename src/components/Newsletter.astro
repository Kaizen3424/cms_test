---
/**
 * Newsletter — soft-green feature card hosting the Dispatch Club island.
 */
import { Mail } from "lucide-react"
import NewsletterForm from "./islands/NewsletterForm.tsx"
---

<section id="newsletter" class="mx-auto max-w-6xl px-6 py-20">
  <div data-reveal class="rounded-2xl bg-primary-pale p-8 text-center md:p-14">
    <div class="mx-auto mb-6 grid h-12 w-12 place-items-center rounded-full bg-canvas text-positive-strong shadow-e1">
      <Mail className="h-6 w-6" aria-hidden />
    </div>

    <h2 class="t-display-sm mb-3 text-ink">Receive the Sunday field dispatch</h2>
    <p class="mx-auto mb-8 max-w-lg text-sm leading-relaxed text-body">
      One quiet postcard delivered every Sunday dawn. Unreleased coordinates, route maps, and
      unfiltered field journals. Zero spam, ever.
    </p>

    <NewsletterForm client:visible />
  </div>
</section>
