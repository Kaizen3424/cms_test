---
/**
 * Stories — white canvas band (DESIGN.md content-band) hosting the
 * StoryBrowser island: SSR cards + client springs for filters and the reader.
 */
import { getCollection } from "astro:content"
import StoryBrowser, { type StoryPost } from "./islands/StoryBrowser.tsx"
import { heroFallback, settings } from "../lib/site-content"
import { formatDate } from "../lib/format"

const raw = await getCollection("posts")
const posts: StoryPost[] = raw
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    excerpt: entry.data.excerpt,
    content: entry.data.content,
    coverImage: entry.data.coverImage ?? undefined,
    destination: entry.data.destination ?? undefined,
    author: entry.data.author ?? undefined,
    readingTime: entry.data.readingTime ?? undefined,
    featured: entry.data.featured,
    tags: entry.data.tags ?? [],
    publishDate: entry.data.publishDate ?? undefined,
  }))
  .sort((a, b) => {
    const at = a.publishDate ? new Date(a.publishDate).getTime() : 0
    const bt = b.publishDate ? new Date(b.publishDate).getTime() : 0
    return bt - at
  })

const destinations = (await getCollection("destinations")).map((d) => ({
  id: d.id,
  name: d.data.name,
}))
---

<section id="stories" class="bg-canvas">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-4 flex flex-col gap-2 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <div class="t-eyebrow mb-3 text-positive-strong">Recent dispatches</div>
        <h2 class="t-display-md text-ink">Field notes from the trail</h2>
      </div>
      <p class="max-w-sm text-xs text-mute md:text-right">
        {posts.length} dispatches · updated {formatDate(posts[0]?.publishDate)}
      </p>
    </div>

    <StoryBrowser client:visible posts={posts} destinations={destinations} heroFallback={heroFallback} />

    <div class="mt-12 text-center" data-reveal>
      <a
        href="/journal/"
        class="pressable inline-flex items-center gap-2 rounded-pill border border-hairline bg-canvas px-6 py-3 text-sm font-semibold text-ink shadow-e1 transition-colors hover:bg-canvas-soft-warm"
      >
        Browse the journal
      </a>
    </div>
  </div>
</section>
