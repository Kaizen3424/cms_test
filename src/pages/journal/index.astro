---
/**
 * /journal/ — the archive index: every dispatch as a simple chronology.
 */
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import Footer from "../../components/Footer.astro"
import { getCollection } from "astro:content"
import { formatDate } from "../../lib/format"
import { heroFallback } from "../../lib/site-content"

const posts = (await getCollection("posts")).sort((a, b) => {
  const at = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0
  const bt = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0
  return bt - at
})
---

<Layout title="Journal · Wanderlust Chronicles" description="Every field dispatch in one chronological archive.">
  <Nav siteTitle="Wanderlust Chronicles" />
  <main class="bg-canvas-soft">
    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="mb-12 max-w-2xl">
        <div class="t-eyebrow mb-3 text-positive-strong">The journal</div>
        <h1 class="t-display-xl mb-4 text-ink">All field dispatches</h1>
        <p class="text-base leading-relaxed text-body">
          Every story, chronologically. Each entry is authored, stored and versioned in a git
          repository through patcms — no database, no server.
        </p>
      </div>

      <ol class="divide-y divide-hairline border-y border-hairline">
        {
          posts.map((post) => (
            <li>
              <a
                href={`/journal/${post.id}/`}
                class="group flex items-center gap-5 py-5 transition-colors"
              >
                <img
                  src={post.data.coverImage ?? heroFallback}
                  alt=""
                  loading="lazy"
                  class="hidden h-16 w-24 shrink-0 rounded-lg object-cover sm:block"
                />
                <span class="flex-1">
                  <span class="block text-xs text-mute">
                    {formatDate(post.data.publishDate, "long")} · {post.data.readingTime}
                  </span>
                  <span class="block text-lg font-bold text-ink transition-colors group-hover:text-positive-strong">
                    {post.data.title}
                  </span>
                </span>
                <span class="text-positive-strong opacity-0 transition-opacity group-hover:opacity-100">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
  <Footer siteTitle="Wanderlust Chronicles" footerText="Git-backed content with patcms." />
</Layout>
