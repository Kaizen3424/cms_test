---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/site/Navbar.astro';
import Footer from '../../components/site/Footer.astro';
import ResponsiveImage from '../../components/media/ResponsiveImage.astro';
import { placeJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const places = await getCollection('places');
  return places
    .filter((p) => p.data.status === 'published')
    .map((p) => ({ params: { slug: p.id }, props: { place: p } }));
}

interface Props {
  place: CollectionEntry<'places'>;
}

const { place } = Astro.props;
const { data } = place;

const allPlaces = await getCollection('places');
const otherPlaces = allPlaces
  .filter((p) => p.data.status === 'published' && p.id !== place.id)
  .sort((a, b) => a.data.dispatchNumber - b.data.dispatchNumber)
  .slice(0, 4);

function frameLayout(index: number) {
  if (index === 0) {
    return {
      colSpan: 'md:col-span-7',
      aspectClass: 'aspect-[4/3]',
      sizes: '(min-width: 1280px) 700px, (min-width: 768px) 58vw, 100vw',
    };
  }
  if (index === 1) {
    return {
      colSpan: 'md:col-span-5',
      aspectClass: 'aspect-[3/4]',
      sizes: '(min-width: 1280px) 500px, (min-width: 768px) 42vw, 100vw',
    };
  }
  if (index === 2) {
    return {
      colSpan: 'md:col-span-4',
      aspectClass: 'aspect-[3/4]',
      sizes: '(min-width: 1280px) 400px, (min-width: 768px) 33vw, 100vw',
    };
  }
  if (index === 3) {
    return {
      colSpan: 'md:col-span-8',
      aspectClass: 'aspect-[16/9]',
      sizes: '(min-width: 1280px) 800px, (min-width: 768px) 67vw, 100vw',
    };
  }
  if (index === 4) {
    return {
      colSpan: 'md:col-span-4',
      aspectClass: 'aspect-[3/4]',
      sizes: '(min-width: 1280px) 400px, (min-width: 768px) 33vw, 100vw',
    };
  }
  if (index === 5) {
    return {
      colSpan: 'md:col-span-5',
      aspectClass: 'aspect-[4/3]',
      sizes: '(min-width: 1280px) 500px, (min-width: 768px) 42vw, 100vw',
    };
  }
  if (index === 6) {
    return {
      colSpan: 'md:col-span-3',
      aspectClass: 'aspect-[3/4]',
      sizes: '(min-width: 1280px) 300px, (min-width: 768px) 25vw, 100vw',
    };
  }
  return {
    colSpan: 'md:col-span-6',
    aspectClass: 'aspect-[4/3]',
    sizes: '(min-width: 1280px) 600px, (min-width: 768px) 50vw, 100vw',
  };
}

const jsonLd = placeJsonLd({
  name: data.name,
  country: data.country,
  subtitle: data.subtitle,
  narrativeStory: data.narrativeStory,
  heroImage: data.heroImage,
  updatedAt: data.updatedAt,
  site: Astro.site,
  slug: place.id,
});
---

<Layout
  title={`${data.name}, ${data.country} — Atlas`}
  description={data.subtitle ?? data.oneLineFragment}
  image={data.heroImage}
  type="article"
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <Navbar />

  <div class="w-full bg-[#fbfbf9] text-[#262622]">
    {/* 1. HERO SECTION: Full Bleed High-Altitude Landscape */}
    <section class="relative w-full h-[92vh] min-h-[640px] max-h-[960px] overflow-hidden bg-[#161614]">
      <ResponsiveImage
        src={data.heroImage}
        alt={data.heroAlt ?? data.name}
        class="absolute inset-0 w-full h-full object-cover object-center select-none"
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />

      {/* Subtle Cinematic Overlays */}
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/35 pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-transparent to-transparent pointer-events-none"></div>

      {/* Top Left: Subtle Back Link */}
      <div class="absolute top-28 left-6 sm:left-14 z-20">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 backdrop-blur-md px-4 py-2 rounded-full text-xs font-medium border border-white/20 transition-all cursor-pointer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-3.5 h-3.5"
            aria-hidden="true"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          <span>Back to the map</span>
        </a>
      </div>

      {/* Top Right: Save to Atlas */}
      <div class="absolute top-28 right-6 sm:right-14 z-20">
        <button
          type="button"
          data-save-place={place.id}
          data-place-name={data.name}
          aria-pressed="false"
          aria-label="Save to your Atlas"
          class="inline-flex items-center gap-2 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 backdrop-blur-md px-4 py-2 rounded-full text-xs font-medium border border-white/20 transition-all cursor-pointer aria-pressed:bg-[#e60023] aria-pressed:border-[#e60023] aria-pressed:text-white aria-pressed:hover:bg-[#cc001f]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-3.5 h-3.5"
            aria-hidden="true"
          >
            <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
          </svg>
          <span>Save to Atlas</span>
        </button>
      </div>

      {/* Hero Content Overlay (Bottom Left) */}
      <div class="absolute bottom-12 sm:bottom-16 left-6 sm:left-14 right-6 sm:right-8 z-20 max-w-4xl">
        {/* Tag / Badge */}
        <div class="inline-flex items-center gap-2 bg-black/40 backdrop-blur-md border border-white/20 px-3.5 py-1 rounded-full text-[11px] font-semibold text-white/90 uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#e60023]"></span>
          <span>Dispatch #{data.dispatchNumber} • Expedition Record</span>
        </div>

        {/* Map Pin + Place + Country */}
        <div class="flex items-baseline gap-3 mb-2 flex-wrap">
          <svg
            class="w-6 h-6 text-[#e60023] flex-shrink-0 self-center"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"></path>
          </svg>
          <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-white leading-none">
            {data.name}
          </h1>
          <span class="text-2xl sm:text-3xl font-light text-white/75 tracking-tight">
            {data.country}
          </span>
        </div>

        {/* One-line Fragment Caption & Coordinates */}
        <div class="flex flex-wrap items-center gap-4 text-white/90 text-base sm:text-lg font-light font-serif-quote pt-1">
          <span>“{data.oneLineFragment}”</span>
          <span class="text-white/40 text-xs font-sans">•</span>
          <span class="font-sans text-xs tracking-wider text-white/70 uppercase">
            {data.coordinatesText} • {data.subtitle || data.category}
          </span>
        </div>
      </div>
    </section>

    {/* 2. FRAGMENT INTRO: Quiet Poetic Lines with Generous Whitespace */}
    <section class="max-w-3xl mx-auto px-6 py-20 sm:py-28 text-center">
      <div class="inline-flex items-center justify-center gap-2 mb-6">
        <span class="h-px w-8 bg-[#dadad3]"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#e60023]"></span>
        <span class="h-px w-8 bg-[#dadad3]"></span>
      </div>

      <div class="font-sans text-xl sm:text-2xl md:text-3xl leading-relaxed text-[#262622] font-normal tracking-wide space-y-2">
        {data.introLines.length > 0 ? (
          data.introLines.map((line, idx) => (
            <p class={idx === 0 ? 'text-[#262622]' : idx === 1 ? 'text-[#33332e]' : 'text-[#62625b]'}>
              {line}
            </p>
          ))
        ) : (
          <p class="text-[#33332e]">{data.narrativeStory}</p>
        )}
      </div>

      <div class="mt-8 text-xs uppercase tracking-widest text-[#91918c] font-sans font-medium">
        Field Emulsion Notes • 120 Format Roll Film • Expedition Journal
      </div>
    </section>

    {/* 3. PHOTO ESSAY GRID: Staggered Masonry Collection */}
    <section class="max-w-7xl mx-auto px-6 sm:px-10 pb-24 sm:pb-28">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-[#dadad3]/60">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#e60023]"></span>
          <h2 class="text-xs font-bold uppercase tracking-widest text-[#262622]">
            Visual Essays & Photographic Log
          </h2>
        </div>
        <span class="text-xs text-[#91918c] font-medium">
          {data.frames.length} medium-format frames
        </span>
      </div>

      {/* Grid Layout */}
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        {data.frames.map((frame, index) => {
          const layout = frameLayout(index);
          return (
            <div class={`${layout.colSpan} group`}>
              <div
                class={`relative bg-[#eeeee9] rounded-[24px] overflow-hidden ${layout.aspectClass} shadow-sm border border-[#e5e5e0] transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-lg`}
              >
                <ResponsiveImage
                  src={frame.url}
                  alt={frame.caption}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  sizes={layout.sizes}
                />
                {frame.locationDetail && (
                  <div class="absolute top-4 left-4 bg-black/40 backdrop-blur-md text-white/90 text-[11px] font-medium px-3 py-1 rounded-full border border-white/10">
                    {frame.locationDetail}
                  </div>
                )}
                <div class="absolute bottom-3 right-3 bg-black/50 backdrop-blur-sm text-white/80 font-mono text-[10px] px-2 py-0.5 rounded-full">
                  FRAME 0{index + 1}
                </div>
              </div>
              <p class="mt-3 text-xs font-medium text-[#62625b] pl-2 flex items-center gap-2">
                <span
                  class={`w-1.5 h-1.5 rounded-full ${
                    index % 2 === 1 ? 'bg-[#e60023]' : 'bg-[#91918c]'
                  }`}
                ></span>
                <span class="font-serif-quote italic text-sm text-[#33332e]">
                  {frame.caption}
                </span>
              </p>
            </div>
          );
        })}
      </div>
    </section>

    {/* 4. STORY PARAGRAPH: Additional Narrative Dispatch */}
    {data.narrativeStory && (
      <section class="max-w-3xl mx-auto px-6 py-12 sm:py-16 border-t border-[#dadad3]/60">
        <div class="text-center mb-6">
          <span class="text-[11px] font-bold tracking-[0.2em] text-[#8e8e86] uppercase block">
            Editorial Notes
          </span>
        </div>
        <div class="prose prose-stone mx-auto text-[#33332e] text-base sm:text-lg leading-relaxed whitespace-pre-line font-serif-quote italic text-center">
          {data.narrativeStory}
        </div>
      </section>
    )}

    {/* 5. TRAVEL THIS ROUTE CALLOUT */}
    <section class="max-w-4xl mx-auto px-6 py-8 sm:py-12 text-center">
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-[#dadad3] shadow-sm space-y-4">
        <span class="text-xs uppercase tracking-widest text-[#e60023] font-bold">
          Guided Route & Bespoke Departures
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-[#1a1a18] tracking-tight">
          Interested in experiencing {data.name}?
        </h3>
        <p class="text-sm text-[#71716b] max-w-lg mx-auto leading-relaxed">
          Our destination specialists arrange small-party logistics, photography guidance, and secluded accommodation across {data.country}.
        </p>
        <div class="pt-2">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-8 py-3.5 bg-[#e60023] hover:bg-[#cc001f] text-white text-xs sm:text-sm font-bold rounded-full shadow-[0_8px_18px_-4px_rgba(230,0,35,0.45)] transition-all cursor-pointer"
          >
            <span>Travel this route with us</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    {/* 6. MORE FROM THE MAP: 4 Place Cards */}
    <section class="border-t border-[#dadad3]/70 bg-[#f4f4f1]/60 py-16 sm:py-20">
      <div class="max-w-7xl mx-auto px-6 sm:px-10">
        <div class="flex items-center justify-between mb-8">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#e60023] mb-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#e60023]"></span>
              <span>Keep Exploring</span>
            </div>
            <h3 class="text-2xl font-bold tracking-tight text-[#000000]">
              More from the map
            </h3>
          </div>
          <a
            href="/"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-[#262622] hover:text-[#e60023] transition-colors cursor-pointer"
          >
            <span>View global explorer</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-3.5 h-3.5"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {otherPlaces.map((related) => (
            <a
              href={`/place/${related.id}`}
              class="group block bg-white rounded-[20px] p-2.5 border border-[#dadad3]/70 shadow-sm hover:border-[#262622] transition-all hover:shadow-md cursor-pointer"
            >
              <div class="relative w-full aspect-[4/3] rounded-[14px] overflow-hidden mb-3 bg-[#e5e5e0]">
                <ResponsiveImage
                  src={related.data.heroImage}
                  alt={related.data.name}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                />
                <div class="absolute top-2.5 left-2.5 bg-black/40 backdrop-blur-md px-2.5 py-0.5 rounded-full text-[10px] font-semibold text-white/90">
                  {related.data.country} · {related.data.category}
                </div>
              </div>
              <div class="px-2 pb-1.5 flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-[#e60023]"></span>
                  <span class="font-bold text-sm text-[#000000] group-hover:text-[#e60023] transition-colors">
                    {related.data.name}
                  </span>
                </div>
                <span class="text-[11px] text-[#62625b] font-medium">
                  {related.data.category}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <Footer />
</Layout>
