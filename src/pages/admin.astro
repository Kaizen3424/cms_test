---
/**
 * /admin/ — the CMS Studio. The panel itself is the untouched patcms
 * playground code (src/panel/**): it is mounted by a client-side module
 * script against the real repository target. The topbar chrome is
 * server-rendered Astro; the panel styles are plain CSS in panel.css which
 * also carries this page's brand chrome.
 */
import Layout from "../layouts/Layout.astro"
import ThemeToggle from "../components/ThemeToggle.astro"
import "../panel/panel.css"
import { githubBackLink } from "../lib/repo.ts"
---

<Layout title="Wanderlust Chronicles · patcms Studio" description="The git-backed CMS studio for the Wanderlust Chronicles." noindex>
  <header class="panel-topbar">
    <div class="panel-topbar-left">
      <a href="/" class="panel-brand-link">← Back to Travel Blog</a>
      <span class="panel-topbar-target">GitHub Target: Kaizen3424/cms_test (main)</span>
    </div>
    <div class="panel-topbar-right">
      <ThemeToggle />
      <a href="https://github.com/Kaizen3424/cms_test" target="_blank" rel="noopener noreferrer" class="panel-repo-link">
        View Repo on GitHub ↗
      </a>
    </div>
  </header>

  <div id="admin-app" class="panel-host"></div>

  <script>
    import { createIdbDraftStore, createIdbTokenStore } from "patcms/web"
    import { mountPanel } from "../panel/index.ts"
    import { travelConfig } from "../cms/config.ts"
    import { repository } from "../lib/repo.ts"

    const host = document.getElementById("admin-app")
    if (host) {
      mountPanel(host, {
        config: travelConfig,
        repository,
        tokenStore: createIdbTokenStore(),
        drafts: createIdbDraftStore(),
        title: "Wanderlust Chronicles · patcms",
      })
    }
  </script>
</Layout>
