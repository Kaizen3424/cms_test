---
/**
 * Landing page — statically rendered from the CMS-managed content (the JSON
 * files under content/). A patcms save commits JSON to this repo; the
 * Cloudflare Pages rebuild re-runs this render, so the page is always the
 * published truth.
 */
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Hero from "../components/Hero.astro"
import Stories from "../components/Stories.astro"
import Destinations from "../components/Destinations.astro"
import Explorer from "../components/Explorer.astro"
import Philosophy from "../components/Philosophy.astro"
import Newsletter from "../components/Newsletter.astro"
import Footer from "../components/Footer.astro"
import { getCollection } from "astro:content"
import { author, settings } from "../lib/site-content"
import type { StoryPost } from "../components/islands/StoryBrowser.tsx"

const description = settings.heroSubheading

const featured = (await getCollection("posts"))
  .map((entry): StoryPost => ({
    id: entry.id,
    title: entry.data.title,
    excerpt: entry.data.excerpt,
    content: entry.data.content,
    coverImage: entry.data.coverImage ?? undefined,
    destination: entry.data.destination ?? undefined,
    author: entry.data.author ?? undefined,
    readingTime: entry.data.readingTime ?? undefined,
    featured: entry.data.featured,
    tags: entry.data.tags ?? [],
    publishDate: entry.data.publishDate ?? undefined,
  }))
  .sort((a, b) => {
    const at = a.publishDate ? new Date(a.publishDate).getTime() : 0
    const bt = b.publishDate ? new Date(b.publishDate).getTime() : 0
    return bt - at
  })
  .slice(0, 4)
---

<Layout title={`${settings.siteTitle} · ${settings.tagline}`} description={description}>
  <!-- Slim top strip: patcms badge + studio link (Wise: the honest, useful bar) -->
  <div class="bg-primary-pale px-4 py-2 text-center text-xs text-ink">
    <span class="inline-flex items-center gap-2">
      <span class="rounded-pill bg-canvas px-2 py-0.5 font-semibold text-positive-deep">patcms</span>
      <span class="text-body">Content powered by patcms · Git-backed &amp; zero database</span>
      <a href="/admin/" class="font-semibold text-positive-strong underline decoration-hairline underline-offset-2 transition-colors hover:text-ink">Open CMS Studio →</a>
    </span>
  </div>

  <Nav siteTitle={settings.siteTitle} />
  <main>
    <Hero settings={settings} featured={featured} />
    <Stories />
    <Destinations destinations={(await getCollection("destinations")).slice().sort((a, b) => a.data.name.localeCompare(b.data.name))} heroFallback="/images/destinations/dolomites-hero.svg" />
    <Explorer author={author} />
    <Philosophy />
    <Newsletter />
  </main>
  <Footer siteTitle={settings.siteTitle} footerText={settings.footerText} />
</Layout>
