---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/site/Navbar.astro';
import Footer from '../components/site/Footer.astro';
---

<Layout
  title="Page not found — Atlas"
  description="This coordinate isn't on our map. Return to the expedition journal."
>
  <Navbar />

  <main class="flex min-h-[80vh] flex-col items-center justify-center px-6 pt-36 pb-24 text-center">
    {/* Badge */}
    <div class="inline-flex items-center gap-2 bg-white px-3.5 py-1 rounded-full border border-[#e2dfd7] shadow-sm text-[11px] font-semibold text-[#71716b] uppercase tracking-widest mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-[#e60023]"></span>
      <span>Off the map • Error 404</span>
    </div>

    {/* Oversized 404 */}
    <h1 class="font-serif-quote text-7xl sm:text-8xl font-bold tracking-tight text-[#1a1a18] leading-none">
      404
    </h1>

    {/* Divider motif */}
    <div class="inline-flex items-center justify-center gap-2 mt-8 mb-6">
      <span class="h-px w-8 bg-[#dadad3]"></span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#e60023]"></span>
      <span class="h-px w-8 bg-[#dadad3]"></span>
    </div>

    <p class="max-w-md text-lg sm:text-xl leading-relaxed text-[#33332e] font-serif-quote italic">
      This coordinate isn't on our map. The frame you're looking for was never developed.
    </p>
    <p class="mt-3 text-xs uppercase tracking-widest text-[#91918c] font-sans font-medium">
      Field Emulsion Notes • Uncharted Plate • Expedition Journal
    </p>

    {/* CTAs */}
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-8 py-3.5 bg-[#e60023] hover:bg-[#cc001f] text-white text-xs sm:text-sm font-bold rounded-full shadow-[0_8px_18px_-4px_rgba(230,0,35,0.45)] transition-all cursor-pointer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        <span>Back to the map</span>
      </a>
      <a
        href="/philosophy"
        class="inline-flex items-center gap-2 px-8 py-3.5 bg-white text-[#1a1a18] text-xs sm:text-sm font-bold rounded-full border border-[#dadad3] hover:border-[#1a1a18] transition-all cursor-pointer"
      >
        <span>Our philosophy</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </main>

  <Footer />
</Layout>
